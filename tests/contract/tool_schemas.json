    "create_proposal_draft": {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "readOnlyHint": false
      },
      "input": {
        "$defs": {
          "DraftPayload": {
            "properties": {
              "amount": {
                "default": 0,
                "maximum": 100000,
                "minimum": 0,
                "title": "Amount",
                "type": "integer"
              },
              "job_id": {
                "maxLength": 100,
                "minLength": 1,
                "title": "Job Id",
                "type": "string"
              },
              "text": {
                "maxLength": 5000,
                "minLength": 12,
                "title": "Text",
                "type": "string"
              }
            },
            "required": [
              "job_id",
              "text"
            ],
            "title": "DraftPayload",
            "type": "object"
          }
        },
        "properties": {
          "approval": {
            "default": "",
            "title": "Approval",
            "type": "string"
          },
          "dry_run": {
            "default": true,
            "title": "Dry Run",
            "type": "boolean"
          },
          "idempotency_key": {
            "maxLength": 160,
            "minLength": 12,
            "title": "Idempotency Key",
            "type": "string"
          },
          "payload": {
            "$ref": "#/$defs/DraftPayload"
          },
          "trace_id": {
            "title": "Trace Id",
            "type": "string"
          },
          "user_id": {
            "title": "User Id",
            "type": "string"
          },
          "weekly_limit": {
            "default": 30,
            "maximum": 100,
            "minimum": 0,
            "title": "Weekly Limit",
            "type": "integer"
          }
        },
        "required": [
          "payload",
          "user_id",
          "trace_id",
          "idempotency_key"
        ],
        "title": "create_proposal_draftArguments",
        "type": "object"
      },
      "output": {
        "properties": {
          "connects": {
            "title": "Connects",
            "type": "integer"
          },
          "payload": {
            "additionalProperties": true,
            "title": "Payload",
            "type": "object"
          },
          "stage": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Stage"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "connects",
          "payload"
        ],
        "title": "WriteResult",
        "type": "object"
      }
    },
