  "components": {
    "schemas": {
      "Approval": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "approve",
              "edit",
              "reject"
            ],
            "title": "Action"
          },
          "text": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 5000
              },
              {
                "type": "null"
              }
            ],
            "title": "Text"
          },
          "reason": {
            "type": "string",
            "maxLength": 500,
            "title": "Reason",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "action"
        ],
        "title": "Approval"
      },
      "Balance": {
        "properties": {
          "remaining": {
            "type": "integer",
            "title": "Remaining"
          },
          "spent": {
            "type": "integer",
            "title": "Spent"
          },
          "week_spent": {
            "type": "integer",
            "title": "Week Spent"
          }
        },
        "type": "object",
        "required": [
          "remaining",
          "spent",
          "week_spent"
        ],
        "title": "Balance"
      },
      "Body_upload_api_portfolio_post": {
